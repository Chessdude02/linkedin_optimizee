# Safe local development defaults. Copy to .env and adjust only if you
# know what you are changing.

# Deny-by-default: no real writes happen. Only flip this on in the
# execution service's (run_executor.py) own environment, after you've
# registered your account's platform_id (see PUBLORA_API_KEY below) and
# reviewed what you're enabling.
WRITE_ENABLED=false

# true (default): every execution is mock -- no real network call, ever.
# false: real execution via control_center/backends/publora.py. Only set
# this to false in the execution service's environment. Never in the
# dashboard's or an agent's.
MOCK_EXECUTION=true

# Must always be true. WRITE_ENABLED=true with this false is refused at
# startup (see control_center/settings.py) -- this build does not support
# unattended publishing without human approval.
APPROVAL_REQUIRED=true

# Minutes a human's approval remains valid before execution must happen or
# the action expires and needs re-approval.
APPROVAL_TTL_MINUTES=15

# Minutes an unapproved request stays open before auto-expiring.
PENDING_TTL_MINUTES=1440

# Where the SQLite database file lives.
CONTROL_CENTER_DB_PATH=control_center.db

# ─────────────────────────────────────────────────────────────────
# Dashboard (Phase 3)
# ─────────────────────────────────────────────────────────────────

# Required. Signs the session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The dashboard refuses to start without this set -- there is no default.
DASHBOARD_SECRET_KEY=

# The single operator account. Generate the hash with:
#   python3 scripts/hash_password.py
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=

# Secure cookies require HTTPS. Only set this to false for local plain-HTTP
# development -- never anywhere resembling production.
DASHBOARD_COOKIE_SECURE=true

DASHBOARD_PORT=5000

# ─────────────────────────────────────────────────────────────────
# Execution service only (Phase 4/5) -- run_executor.py's process.
#
# CRITICAL: set this ONLY in the environment that runs run_executor.py.
# Never put it in the dashboard's .env, never in an agent's environment.
# control_center/backends/publora.py reads it, and that module is only
# ever imported lazily from executor._run_backend when MOCK_EXECUTION is
# false -- so as long as this variable is absent everywhere except the
# execution service, nothing else can reach it even by accident.
# ─────────────────────────────────────────────────────────────────
# PUBLORA_API_KEY=sk_...

# Before approving real actions against an account, register it once:
#   python3 scripts/register_account.py

# ─────────────────────────────────────────────────────────────────
# Research Agent (agents/research_agent.py) -- reads specific
# watched posts and surfaces non-actionable research findings for human
# review. Read-only; cannot publish anything itself, and cannot create a
# pending action either -- only an explicit "Create Action Proposal"
# click in the dashboard's Research tab can do that. Manage the
# watchlist with scripts/manage_watchlist.py.
# ─────────────────────────────────────────────────────────────────

# Sign up free: https://console.apify.com/sign-up
# Token: https://console.apify.com/settings/integrations
# APIFY_TOKEN=apify_api_...

# Without this, the Research Agent surfaces nothing at all (a
# low-quality template draft isn't worth a human's review time, so it
# just skips drafting rather than producing one).
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
